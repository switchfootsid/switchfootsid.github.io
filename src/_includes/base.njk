<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{%- set pageTitle = (title + " · " + site.name) if title else site.name %}
{%- set pageDesc = dek or site.description %}
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDesc }}">
<link rel="canonical" href="{{ page.url | absoluteUrl(site.url) }}">
<meta property="og:title" content="{{ title or site.name }}">
<meta property="og:description" content="{{ pageDesc }}">
<meta property="og:type" content="{{ 'article' if layout == 'post.njk' else 'website' }}">
<link rel="alternate" type="application/atom+xml" href="/feed.xml" title="{{ site.name }}">
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
<script>
  (function () {
    var t = null;
    try { t = localStorage.getItem("theme"); } catch (e) {}
    if (t !== "light" && t !== "dark") t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
    document.documentElement.dataset.theme = t;
  })();
</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/site.css">
</head>
<body class="{{ bodyClass }}">
<header class="bar">
  <div class="wrap">
    <a class="name" href="/">{{ site.name }}</a>
    <nav class="nav" aria-label="Primary">
      <a href="/" {% if nav == "home" %}aria-current="page"{% endif %}>Home</a>
      <a href="/writing/" {% if nav == "writing" %}aria-current="page"{% endif %}>Writing</a>
      <a href="/media/" {% if nav == "media" %}aria-current="page"{% endif %}>Media &amp; Talks</a>
    </nav>
    <button class="theme" id="theme" type="button" aria-label="Switch to dark theme">
      <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
      <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/></svg>
    </button>
  </div>
  <span class="readbar" id="readbar"></span>
</header>

<main class="wrap">
{{ content | safe }}
</main>

<footer>
  <div class="wrap">
    <span>&copy; {{ year }} {{ site.name }}</span>
    <a href="/feed.xml">RSS</a>
  </div>
</footer>
<script src="/assets/js/site.js"></script>
</body>
</html>
